---
import Base from '../layouts/Base.astro';
---

<Base title="404 · Not found">
  <section class="nf">
    <p class="mono muted">HTTP 404</p>
    <h1>Nothing at this address.</h1>
    <p>The query ran fine. It just returned zero rows.</p>
    <p><a href="/">Back to the homepage</a></p>
  </section>
</Base>

<style>
  .nf { padding-top: 4rem; }
</style>
