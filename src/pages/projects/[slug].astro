---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => import.meta.env.DEV || !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, year, stack, status, stat, live, code } = project.data;
---

<Base title={`${title} · ${site.name}`} description={summary}>
  <article class="spec">
    <a href="/#work" class="back">← All work</a>
    <p class="meta mono">{year} · {status}</p>
    <h1>{title}</h1>
    <p class="summary">{summary}</p>
    {stat && <p class="stat mono">{stat}</p>}
    <ul class="tags">{stack.map((s) => <li>{s}</li>)}</ul>
    {(live || code) && (
      <p class="links">
        {live && <a href={live}>Live ↗</a>}
        {code && <a href={code}>Code ↗</a>}
      </p>
    )}
    <div class="body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .spec { padding-top: 2rem; }
  .back { font-size: 0.9rem; text-decoration: none; }
  .meta { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 2rem; }
  h1 { font-size: clamp(1.9rem, 6vw, 2.6rem); letter-spacing: -0.02em; }
  .summary { font-size: 1.15rem; }
  .stat { color: var(--accent); }
  .links { display: flex; gap: 1rem; }
  .body :global(h2) { margin-top: 2.5rem; }
  .body :global(pre) { background: var(--surface); padding: 1rem; border-radius: 6px; overflow-x: auto; }
  .body :global(img) { max-width: 100%; height: auto; border-radius: 6px; }
</style>
